{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Action",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "task",
        "activity",
        "intervention",
        "follow_up",
        "other"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "owner": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "subject": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "due_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "open",
        "in_progress",
        "completed",
        "cancelled",
        "overdue"
      ]
    },
    "priority": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "low",
        "normal",
        "high",
        "critical",
        null
      ]
    },
    "related_commitment": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance": {
      "$ref": "provenance.schema.json"
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "id",
    "action_type",
    "title",
    "status",
    "provenance"
  ],
  "additionalProperties": false
}
