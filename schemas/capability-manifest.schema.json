{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Node Capability Manifest",
  "type": "object",
  "properties": {
    "protocol": {
      "const": "oos/0.1-draft"
    },
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "provides": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "emits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "accepts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "queries": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "protocol",
    "node",
    "provides",
    "emits",
    "accepts",
    "queries",
    "actions"
  ],
  "additionalProperties": false
}
