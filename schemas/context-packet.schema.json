{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Context Packet",
  "type": "object",
  "properties": {
    "specversion": {
      "const": "0.1-draft"
    },
    "id": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "requested_by": {
      "type": "string"
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "value": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "type",
          "id",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "scope": {
      "type": "string",
      "enum": [
        "private",
        "shared",
        "published"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "provenance": {
      "$ref": "provenance.schema.json"
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "specversion",
    "id",
    "subject",
    "purpose",
    "requested_by",
    "objects",
    "scope",
    "generated_at",
    "provenance"
  ],
  "additionalProperties": false
}
