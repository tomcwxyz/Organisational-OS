{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Organisational OS Event",
  "type": "object",
  "properties": {
    "specversion": {
      "const": "0.1-draft"
    },
    "id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "source": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "organisation": {
      "type": [
        "string",
        "null"
      ]
    },
    "actor": {
      "type": [
        "string",
        "null"
      ]
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "additionalProperties": true
    },
    "provenance": {
      "$ref": "provenance.schema.json"
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "specversion",
    "id",
    "type",
    "source",
    "subject",
    "time",
    "data",
    "provenance"
  ],
  "additionalProperties": false
}
