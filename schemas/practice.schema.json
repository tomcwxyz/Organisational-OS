{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Practice",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": [
        "string",
        "null"
      ]
    },
    "owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "instructions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "evaluation": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "version": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "retired"
      ]
    },
    "provenance": {
      "$ref": "provenance.schema.json"
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "id",
    "name",
    "purpose",
    "version",
    "status",
    "provenance"
  ],
  "additionalProperties": false
}
